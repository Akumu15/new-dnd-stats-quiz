rules_version = '2';

// Roll For Real security rules.
//
//   heroes/{uid}               private full save, owner only
//   cards/{uid}                public card (name, level, class, scores…), readable by party mates
//   parties/{code}             party: name, owner, member uids (max 6); the code is the invite
//   parties/{code}/feed/{id}   party chronicle: rallies, wins (append-only, members only)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function party(code) { return get(/databases/$(database)/documents/parties/$(code)).data; }
    function isMember(code) { return signedIn() && request.auth.uid in party(code).members; }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // ── Private save ─────────────────────────────────────────────
    match /heroes/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['save', 'updatedAt'])
        && request.resource.data.save is map
        && request.resource.data.updatedAt is number;
    }

    // ── Public card (shown to party mates) ───────────────────────
    match /cards/{uid} {
      // `resource == null`: a card that doesn't exist yet reveals nothing, and allowing it lets a
      // party mate's listener wait for a new member's card instead of being cancelled.
      allow read: if isSelf(uid)
        || resource == null
        || (resource.data.partyId is string && isMember(resource.data.partyId));
      allow delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'level', 'heroClass', 'scores', 'streak', 'partyId', 'week', 'weekDamage', 'updatedAt'])
        && shortString(request.resource.data.name, 40)
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 99
        && shortString(request.resource.data.heroClass, 30)
        && request.resource.data.scores is map
        && request.resource.data.scores.keys().hasOnly(['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'])
        && request.resource.data.streak is int
        && shortString(request.resource.data.week, 10)
        && request.resource.data.weekDamage is int && request.resource.data.weekDamage >= 0 && request.resource.data.weekDamage <= 2000
        // You can only point your card at a party you actually belong to.
        && (request.resource.data.partyId == null || isMember(request.resource.data.partyId));
    }

    // ── Parties ──────────────────────────────────────────────────
    match /parties/{code} {
      // Knowing the code is the invitation: anyone signed in may fetch a party by code,
      // but nobody can list or search parties.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'members', 'createdAt'])
        && shortString(request.resource.data.name, 40)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // Join: add exactly yourself, party of at most 6.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 6)
        ||
        // Leave: remove exactly yourself.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
        ||
        // Rename: the founder only.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.auth.uid == resource.data.ownerUid
          && shortString(request.resource.data.name, 40))
      );

      // The last member leaving may disband the party.
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];

      // ── Party chronicle ────────────────────────────────────────
      match /feed/{entryId} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromName', 'toUid', 'toName', 'detail', 'createdAt'])
          && request.resource.data.type in ['rally', 'join', 'leave', 'boss', 'trial', 'level']
          && request.resource.data.fromUid == request.auth.uid
          && shortString(request.resource.data.fromName, 40)
          && (!('toUid' in request.resource.data) || shortString(request.resource.data.toUid, 128))
          && (!('toName' in request.resource.data) || shortString(request.resource.data.toName, 40))
          && (!('detail' in request.resource.data) || shortString(request.resource.data.detail, 80))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
